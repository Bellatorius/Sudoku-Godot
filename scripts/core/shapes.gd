	["Bird House", ["31>13>14>36", "31>61>66>36", "43>44"]],
	["UFO", ["32>23>24>35", "31>36", "31>42>45>36"]],
	["Crown", ["51>21>32>23>34>25>36>56", "51>56"]],
	["Trophy", ["11>16", "11>33", "16>34", "33>34", "33>53", "52>54"]],
	["Medal", ["11>33>15", "33>43", "43>52>63", "63>54>43"]],
	["Bottle", ["13>14", "13>23", "14>24", "23>32>62", "24>35>65", "62>65"]],
]


## The picture's paths as cell index arrays for an n x n grid. Cells are "rc" tokens; "11>19>99" is
## shorthand for straight runs between corners (rows, columns or 45-degree diagonals).
static func parse(paths: Array, n: int) -> Array:
	var out: Array = []
	for p in paths:
		var cells: Array = []
		for tok in str(p).replace(">", " ").split(" ", false):
			if tok.length() != 2 or not tok.is_valid_int():
				continue
			var r := int(tok[0]) - 1
			var c := int(tok[1]) - 1
			if cells.is_empty():
				cells.append(r * n + c)
				continue
			var last: int = cells[-1]
			var dr := signi(r - last / n)
			var dc := signi(c - last % n)
			var rr := last / n
			var cc := last % n
			while rr != r or cc != c:
				rr += dr
				cc += dc
				cells.append(rr * n + cc)
		if cells.size() >= 2:
			out.append(cells)
	return out


## One of the 8 rotations / mirrors of the grid (k = 0..7) applied to a cell.
static func map_cell(c: int, k: int, n: int) -> int:
	var r := c / n
	var q := c % n
	if k & 4:
		var t := r; r = q; q = t
	if k & 1:
		q = n - 1 - q
	if k & 2:
		r = n - 1 - r
	return r * n + q


static func transform(paths: Array, k: int, n: int) -> Array:
	var out: Array = []
	for p in paths:
		out.append(p.map(func(c): return map_cell(c, k, n)))
	return out


# ----------------------------------------------------------------- procedural designs

const _ADJ := ["Silver", "Quiet", "Wild", "Paper", "Hidden", "Golden", "Crystal", "Rusty", "Lucky", "Velvet",
	"Frozen", "Midnight", "Copper", "Amber", "Scarlet", "Hollow", "Gentle", "Iron", "Misty", "Electric"]
const _MIRROR := ["Moth", "Mask", "Totem", "Lantern", "Temple", "Owl", "Beetle", "Antler", "Chalice", "Gate", "Kite", "Fountain"]
const _ROTATE := ["Pinwheel", "Windmill", "Compass", "Snowflake", "Vortex", "Rose", "Knot", "Galaxy", "Propeller", "Mandala"]


## A symmetric design: random strokes (mostly straight runs with gentle turns) in one part of the grid,
## copied by the symmetry; strokes started on a mirror axis join their copy into one line.
## Returns [name, paths as cell arrays] (paths may be empty if the rng was unlucky; just call again).
static func procedural(rng: RandomNumberGenerator, n: int) -> Array:
	var sym := rng.randi_range(0, 2)   # 0 mirror left-right, 1 mirror top-bottom, 2 half turn (no quarter turns:
	                                   # rotated hooks can look like a hooked cross)
	var images := func(c: int) -> Array:
		match sym:
			0: return [c, map_cell(c, 1, n)]
			1: return [c, map_cell(c, 2, n)]
			2: return [c, map_cell(c, 3, n)]
		var r := c / n
		var q := c % n
		return [c, q * n + (n - 1 - r), (n - 1 - r) * n + (n - 1 - q), (n - 1 - q) * n + r]
	var used := {}
	var segs := {}
	var paths: Array = []
	var want := int(n * n * rng.randf_range(0.42, 0.58))
	var tries := 0
	while used.size() < want and tries < 200:
		tries += 1
		# start next to the design (junction) most of the time, so the picture hangs together
		var start := rng.randi_range(0, n * n - 1)
		if not paths.is_empty() and rng.randf() < 0.65:
			var host: Array = paths[rng.randi_range(0, paths.size() - 1)]
			start = host[0] if rng.randf() < 0.5 else host[-1]
		var length := rng.randi_range(3, mini(7, n))
		var path: Array = [start]
		var dir := Vector2i(rng.randi_range(-1, 1), rng.randi_range(-1, 1))
		while path.size() < length:
			var cur: int = path[-1]
			var opts: Array = []
			for dr in [-1, 0, 1]:
				for dc in [-1, 0, 1]:
					if dr == 0 and dc == 0:
						continue
					var rr: int = cur / n + dr
					var cc: int = cur % n + dc
					if rr < 0 or rr >= n or cc < 0 or cc >= n:
						continue
					var nb := rr * n + cc
					if used.has(nb) or path.has(nb) or _cross(cur, nb, segs, n):
						continue
					var w := 1.0
					if Vector2i(dr, dc) == dir: w = 6.0          # keep going straight
					elif absi(dr - dir.x) + absi(dc - dir.y) == 1: w = 2.5   # 45 degree turn
					opts.append([nb, w, Vector2i(dr, dc)])
			if opts.is_empty():
				break
			var total := 0.0
			for o in opts: total += o[1]
			var pick := rng.randf() * total
			for o in opts:
				pick -= o[1]
				if pick <= 0.0:
					path.append(o[0])
					dir = o[2]
					break
		if path.size() < 3:
			continue
		# the copies must not collide with the stroke or the design
		var copies: Array = []
		var clash := false
		var mine := {}
		for c in path:
			mine[c] = true
		for k in range(1, images.call(path[0]).size()):
			var cp: Array = path.map(func(c): return images.call(c)[k])
			copies.append(cp)
		var joined := false
		if sym <= 1 and copies.size() == 1 and copies[0][0] == path[0] and used.get(path[0], false) == false:
			# started on the axis: stroke + mirror form one symmetric line through it
			var line: Array = copies[0].duplicate()
			line.reverse()
			line.append_array(path.slice(1))
			var seen := {}
			for c in line:
				if seen.has(c): clash = true
				seen[c] = true
			if not clash:
				paths.append(line)
				for c in line: used[c] = true
				_add_segs(line, segs, n)
				joined = true
		if joined:
			continue
		for cp in copies:
			for i in cp.size():
				var c: int = cp[i]
				if (mine.has(c) and c != path[0]) or (used.has(c) and i > 0):
					clash = true
		if clash:
			continue
		for p in [path] + copies:
			paths.append(p)
			for c in p: used[c] = true
			_add_segs(p, segs, n)
	var names: Array = _ROTATE if sym >= 2 else _MIRROR
	var name := "%s %s" % [_ADJ[rng.randi_range(0, _ADJ.size() - 1)], names[rng.randi_range(0, names.size() - 1)]]
	return [name, paths]


static func _seg_key(a: int, b: int) -> String:
	return "%d-%d" % [mini(a, b), maxi(a, b)]


## A diagonal step a->b may not cross an existing diagonal step (an X between four cells).
static func _cross(a: int, b: int, segs: Dictionary, n: int) -> bool:
	var ra := a / n
	var ca := a % n
	var rb := b / n
	var cb := b % n
	if ra == rb or ca == cb:
		return false
	return segs.has(_seg_key(ra * n + cb, rb * n + ca))


static func _add_segs(p: Array, segs: Dictionary, n: int) -> void:
	for i in p.size() - 1:
		segs[_seg_key(p[i], p[i + 1])] = true


## True if lines form a cross anywhere: one cell with lines going up, down, left and right (+),
## or out along all four diagonals (X). Pictures never use crosses.
static func has_cross(paths: Array, n: int) -> bool:
	var dirs := {}   # cell -> bitmask of the 8 directions its line steps go
	for p in paths:
		for i in p.size() - 1:
			var a: int = p[i]
			var b: int = p[i + 1]
			var d := Vector2i(b / n - a / n, b % n - a % n)
			dirs[a] = int(dirs.get(a, 0)) | _dir_bit(d)
			dirs[b] = int(dirs.get(b, 0)) | _dir_bit(-d)
	for c in dirs:
		var m: int = dirs[c]
		if m & 0x0F == 0x0F or m & 0xF0 == 0xF0:
			return true
	return false


static func _dir_bit(d: Vector2i) -> int:
	match d:
		Vector2i(-1, 0): return 1
		Vector2i(1, 0): return 2
		Vector2i(0, -1): return 4
		Vector2i(0, 1): return 8
		Vector2i(-1, -1): return 16
		Vector2i(1, 1): return 32
		Vector2i(-1, 1): return 64
		Vector2i(1, -1): return 128
	return 0
