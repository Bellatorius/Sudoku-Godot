static func get_info(id: String) -> Dictionary:
	for v in LIST:
		if v.id == id:
			return v
	return {}


static func is_playable(id: String) -> bool:
	return id in CORE


static func display_name(id: String) -> String:
	return get_info(id).get("name", id.capitalize())
